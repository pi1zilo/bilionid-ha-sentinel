# Copy to .env (0600). Set values before deployment.
NODE_ROLE=PRIMARY
NODE_NAME=main
PEER_NODE_NAME=backup
TAILSCALE_IP=127.0.0.1
PEER_TAILSCALE_IP=127.0.0.1

# HA_BIND_IP is the address on the HOST. Set it to the private address on
# paired nodes. HA_HOST is the address INSIDE the container.
HA_BIND_IP=127.0.0.1
HA_HOST=0.0.0.0
HA_PORT=29010
HA_PEER_PORT=29010
HA_PEER_ENABLED=false
HA_WATCH_PRIMARY=false
HA_SECRET_KEY=
HA_HEARTBEAT_INTERVAL_SEC=5

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
TELEGRAM_ADMIN_USER_ID=0
# Optional: restrict commands to this chat. 0 allows the owner in any chat.
TELEGRAM_COMMAND_CHAT_ID=0
# Explicit flag for manual handover. If omitted, PRIMARY polls and STANDBY waits.
# TELEGRAM_POLLING_ENABLED=true

BESZEL_ENABLED=false
BESZEL_MAIN_URL=
BESZEL_BACKUP_URL=
BESZEL_USERNAME=
BESZEL_PASSWORD=
BESZEL_AUTH_TOKEN=
BESZEL_BACKUP_USERNAME=
BESZEL_BACKUP_PASSWORD=
BESZEL_BACKUP_AUTH_TOKEN=

UPTIME_KUMA_ENABLED=false
UPTIME_KUMA_URL=
UPTIME_KUMA_API_KEY=
UPTIME_KUMA_STATUS_PAGE_SLUG=
# Optional 32+ character secret for POST /events/kuma. Leave blank for polling.
UPTIME_KUMA_WEBHOOK_SECRET=

ZABBIX_URL=
ZABBIX_API_TOKEN=
# Optional 32+ character secret for POST /events/zabbix.
ZABBIX_WEBHOOK_SECRET=

DOCKER_MONITOR_ENABLED=false
DOCKER_PROXY_URL=
MONITOR_INTERVAL_SEC=15
MONITOR_SOURCE_FAILURES=2
ALERT_TIMEZONE=Europe/Moscow
DATA_DIR=/app/data
LOG_LEVEL=INFO
LOG_FORMAT_JSON=true

APP_UID=1000
APP_GID=1000
IMAGE_TAG=dev
# PYTHON_IMAGE can override the verified Python base image.
