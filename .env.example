# ==============================================================================
# BilioniD HA Sentinel — Конфигурация окружения (.env)
# ==============================================================================
# ВНИМАНИЕ: Защитите этот файл правами chmod 600 .env.
# Никогда не коммитьте боевой .env в систему контроля версий!
# ==============================================================================

# --- РОЛЬ И ИДЕНТИФИКАЦИЯ УЗЛА ---
# PRIMARY — для основного сервера (Main)
# STANDBY — для резервного сервера (Backup)
NODE_ROLE=PRIMARY

# Человекочитаемое имя узла
NODE_NAME=Primary-VPS

# Tailscale IP текущего узла (например, 100.64.0.1)
TAILSCALE_IP=100.64.0.1

# Имя и Tailscale IP парного узла
PEER_NODE_NAME=Backup-VPS
PEER_TAILSCALE_IP=100.64.0.2

# --- HIGH AVAILABILITY (HA) ---
# Порт для межсерверного взаимодействия через Tailscale
# Рекомендуемый свободный порт для HA: 29010
HA_PORT=29010
HA_HOST=0.0.0.0

# Общий секретный ключ для авторизации запросов между нодами (32+ символов)
# Должен быть ОДИНАКОВЫМ на обоих серверах!
HA_SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string

# Интервалы проверок в секундах
HA_HEARTBEAT_INTERVAL_SEC=5.0
HA_FAILOVER_TIMEOUT_SEC=30.0
HA_RECOVERY_TIMEOUT_SEC=30.0
HA_LEASE_DURATION_SEC=15.0

# --- TELEGRAM BOT ---
# Единый токен бота от @BotFather (одинаковый на Main и Backup)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# Chat ID для системных алертов о переключениях HA (группа или личный чат)
TELEGRAM_CHAT_ID=-1001234567890

# User ID владельца бота (строгая авторизация, доступ разрешен ТОЛЬКО ему)
TELEGRAM_ADMIN_USER_ID=123456789

# Ограничение частоты команд (защита от флуда)
RATE_LIMIT_COMMANDS_PER_MIN=30

# --- BESZEL HUB MONITORING ---
# Main Beszel Hub (находится на Main, порт 29001)
BESZEL_MAIN_URL=http://100.64.0.1:29001

# Backup Beszel Hub (находится на Backup, порт 29000)
BESZEL_BACKUP_URL=http://100.64.0.2:29000

# Авторизация в Beszel Hub (PocketBase), если требуется (опционально)
BESZEL_USERNAME=
BESZEL_PASSWORD=
BESZEL_AUTH_TOKEN=

# --- UPTIME KUMA MONITORING (ОПЦИОНАЛЬНО) ---
# Находится на Main, порт 29000
UPTIME_KUMA_ENABLED=true
UPTIME_KUMA_URL=http://100.64.0.1:29000
UPTIME_KUMA_API_KEY=
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

# --- DOCKER MONITORING ---
# Путь к сокету Docker (монтируется в контейнер в режиме read-only :ro)
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_MONITOR_ENABLED=true

# --- ХРАНИЛИЩЕ И ЛОГИ ---
DATA_DIR=/app/data
LOG_LEVEL=INFO
LOG_FORMAT_JSON=true
